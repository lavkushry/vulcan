# Project Vulcan: Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://vulcan_admin:vulcan_secure_password_2026@localhost:5432/vulcan_control_plane

# Distributed Lock & Queue (Redis 7.2)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / AWS S3 for 10GB payloads)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=vulcan_minio_admin
S3_SECRET_KEY=vulcan_minio_secret_2026
S3_BUCKET_NAME=vulcan-artifacts
S3_REGION=us-east-1

# Enterprise Simulation Mode (Set false for live PNC CyberArk & ServiceNow)
SIMULATION_MODE=true

# Security & Invariants
FAIL_CLOSED_TIMEOUT_SECONDS=900
REDLOCK_LEASE_MS=30000
WATCHDOG_HEARTBEAT_SECONDS=10
