# ==============================================================================
# PROJECT VULCAN: Environment Variables & Secrets Template
# Copy to deploy/.env (chmod 600) and fill with production-grade random secrets.
# NEVER commit deploy/.env to source control.
# ==============================================================================

# PostgreSQL 16 (pgvector)
POSTGRES_DB=vulcan_control_plane
POSTGRES_USER=vulcan_admin
POSTGRES_PASSWORD=replace_with_secure_postgres_password_32_chars

# Redis 7.2
REDIS_PASSWORD=replace_with_secure_redis_password_32_chars
REDIS_URL=redis://:replace_with_secure_redis_password_32_chars@redis:6379/0

# MinIO S3 Object Storage
MINIO_ROOT_USER=replace_with_minio_admin_username
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password_32_chars
S3_BUCKET_NAME=vulcan-artifacts
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Vulcan Control Plane API Tokens (Server-side Token -> Identity Map)
# JSON map format: {"<token>": "<user_id>", ...}
VULCAN_API_TOKENS={"vlc_replace_lead_bob_token": "lead.bob", "vlc_replace_eng_alice_token": "eng.alice", "vlc_replace_admin_token": "system.admin"}
NEXT_PUBLIC_VULCAN_API_TOKEN=vlc_replace_eng_alice_token

# Environment & Flags
VULCAN_ENV=production
SIMULATION_MODE=false
